# =================================================================
# VartaCore Configuration
# =================================================================

# Server Port
PORT=8080
ENV=development

# MySQL Database Connection (Docker / Local)
# When running inside Docker Compose:
MYSQL_DSN=root:vartapass@tcp(mysql:3306)/varta?parseTime=true&charset=utf8mb4
# When running locally on Mac host:
# MYSQL_DSN=root:vartapass@tcp(127.0.0.1:3306)/varta?parseTime=true&charset=utf8mb4

# Redis Cache (Docker / Local)
# When running inside Docker Compose:
REDIS_ADDR=redis:6379
# When running locally on Mac host:
# REDIS_ADDR=127.0.0.1:6379
REDIS_PASSWORD=
REDIS_DB=0

# News Ingestion Settings
NEWS_FETCH_INTERVAL_MINUTES=15
RSS_FEEDS=https://www.goodnewsnetwork.org/feed/,https://www.positive.news/feed/,https://www.optimistdaily.com/feed/,http://feeds.bbci.co.uk/news/science_and_environment/rss.xml

# Optional External News API Key (e.g. NewsData.io)
NEWS_API_KEY=
NEWS_API_ENDPOINT=https://newsdata.io/api/1/news

# Optional Google Gemini API Key for enhanced AI scoring/summarization
GEMINI_API_KEY=

# CORS Configuration (defaults to * for development)
CORS_ALLOWED_ORIGIN=*
